{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [".next/**", "!.next/cache/**", "dist/**"],
			"cache": true
		},
		"test": {
			"dependsOn": ["^test"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["coverage/**"],
			"cache": true
		},
		"lint": {
			"dependsOn": ["^lint"],
			"cache": true
		},
		"check": {
			"dependsOn": ["^check"],
			"cache": true
		},
		"format": {
			"dependsOn": ["^format"],
			"cache": false
		},
		"check-types": {
			"dependsOn": ["^check-types"],
			"cache": true
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
