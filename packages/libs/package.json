{
	"name": "@chanooda/libs",
	"version": "0.0.9",
	"description": "",
	"author": "@chanooda",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+ssh://github.com/chanooda/chanoo-libs.git"
	},
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"scripts": {
		"test": "vitest",
		"test:ui": "vitest --ui",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"build": "tsup src/index.ts --format esm,cjs --dts",
		"dev": "tsup src/index.ts --format cjs,esm --dts --watch",
		"format": "biome format --write",
		"lint": "biome lint --write --unsafe --max-diagnostics=none",
		"check": "biome check --write --unsafe --max-diagnostics=none",
		"ci-check": "biome ci"
	},
	"devDependencies": {
		"@chanooda/biome-config-frontend": "workspace:*",
		"@chanooda/typescript-config-frontend": "workspace:*",
		"@vitest/ui": "^4.0.18",
		"jsdom": "^26.0.0",
		"tsup": "^8.5.1",
		"vitest": "^4.0.18"
	},
	"peerDependencies": {
		"@types/node": "*"
	},
	"publishConfig": {
		"main": "./dist/index.js",
		"module": "./dist/index.mjs",
		"types": "./dist/index.d.ts",
		"registry": "https://npm.pkg.github.com/",
		"files": [
			"dist"
		]
	}
}
